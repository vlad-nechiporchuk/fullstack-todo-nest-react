# Local infrastructure (docker compose reads this file as .env). Development-only values.
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=todo
# Host port for PostgreSQL. 55432 rather than 5432 so a locally installed PostgreSQL does not get in the way.
POSTGRES_PORT=55432
# Host port for the API (Swagger UI at /docs).
API_PORT=3001
# Host port for the web app, the address to open in a browser.
WEB_PORT=8080
